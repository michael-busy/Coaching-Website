{
  "name": "chernyakov-coaching",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "r2:seed": "node scripts/seed-r2.mjs",
    "dev": "pnpm env:init && pnpm --parallel --filter @coaching/web --filter @coaching/api dev",
    "dev:backend": "pnpm env:init && pnpm --filter @coaching/api dev",
    "dev:frontend": "pnpm env:init && pnpm --filter @coaching/web dev",
    "build": "pnpm --filter @coaching/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "preview": "pnpm env:init && pnpm build && pnpm --filter @coaching/api preview",
    "deploy": "REQUIRE_TURNSTILE_SITE_KEY=true pnpm build && pnpm --filter @coaching/api deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
