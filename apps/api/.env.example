# Backend (Cloudflare Worker) local environment for `pnpm dev` / `pnpm dev:backend`.
# Copy to apps/api/.env (git-ignored; `pnpm env:init` does it for you). Wrangler loads it on
# `wrangler dev`. These values are for local development only — production secrets are set
# with `wrangler secret put` (see DEPLOY.md) and plain vars live in wrangler.jsonc.

# --- MailerLite ---------------------------------------------------------------------------
# true: skip MailerLite and log the download link to the terminal instead (no account needed).
# Set to false and fill in the token + group ids below to test against a real MailerLite
# account (use test groups, not the production ones).
MAILERLITE_DRY_RUN=true
MAILERLITE_API_TOKEN=
MAILERLITE_GROUP_ID=
MAILERLITE_NEWSLETTER_GROUP_ID=

# --- Cloudflare Turnstile -----------------------------------------------------------------
# Cloudflare's always-pass test secret; pairs with the default test site key in the frontend.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Gated downloads ----------------------------------------------------------------------
# Signs the download links. Any long random string works locally (`openssl rand -base64 32`).
DOWNLOAD_TOKEN_SECRET=local-dev-only-not-a-real-secret
DOWNLOAD_LINK_TTL_DAYS=14
