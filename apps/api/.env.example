# Backend (Cloudflare Worker) local environment for `pnpm dev` / `pnpm dev:backend`.
# Copy to apps/api/.env (git-ignored; `pnpm env:init` does it for you). Wrangler loads it on
# `wrangler dev`. These values are for local development only — production secrets are set
# with `wrangler secret put` (see DEPLOY.md) and plain vars live in wrangler.jsonc.

# --- MailerLite ---------------------------------------------------------------------------
# true: skip MailerLite and log the subscriber payload to the terminal (no account needed).
# false: talk to the real account. Add the token; the group ids below are the TEST_Downloads
# and TEST_Offers groups (production ids live in wrangler.jsonc — never use them here).
# The account needs these text fields: downloads, last_download, marketing_consent,
# marketing_consent_at, consent_text_version (TODO.md §3).
MAILERLITE_DRY_RUN=true
MAILERLITE_API_TOKEN=
MAILERLITE_DOWNLOADS_GROUP_ID=201853603281897056
MAILERLITE_OFFERS_GROUP_ID=201852584377452507

# --- Cloudflare Turnstile -----------------------------------------------------------------
# Cloudflare's always-pass test secret; pairs with the default test site key in the frontend.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Gated downloads ----------------------------------------------------------------------
# Signs the download links. Any long random string works locally (`openssl rand -base64 32`).
DOWNLOAD_TOKEN_SECRET=local-dev-only-not-a-real-secret
DOWNLOAD_LINK_TTL_HOURS=24
