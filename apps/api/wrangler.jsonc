{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chernyakov-coaching",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The prerendered web app. Only /api/* runs the Worker first; everything else is served
  // straight from the asset store (free, unmetered requests).
  "assets": {
    "directory": "../web/build/client",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },

  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "coaching-downloads" }],

  "ratelimits": [
    {
      "name": "SIGNUP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],

  // Non-secret configuration. Secrets are set with `wrangler secret put` (see TODO.md §2).
  "vars": {
    // JSON: resource slug → MailerLite "Download: …" group id (TODO.md §3).
    "MAILERLITE_RESOURCE_GROUP_IDS": "",
    "MAILERLITE_OFFERS_GROUP_ID": "",
    "DOWNLOAD_LINK_TTL_HOURS": "24",
  },

  // Custom domains are attached at cutover (TODO.md §5), e.g.:
  // "routes": [
  //   { "pattern": "chernyakov-coaching.com", "custom_domain": true },
  //   { "pattern": "www.chernyakov-coaching.com", "custom_domain": true }
  // ]
}
