# Frontend local environment for `pnpm dev` / `pnpm dev:frontend`.
# Copy to apps/web/.env (git-ignored; `pnpm env:init` does it for you).

# Backend the frontend connects to. The browser always calls /api/* on the dev server, which
# forwards to this URL — so it can be the local Worker or a deployed one, with no CORS setup.
# Default: the local Worker started by `pnpm dev:backend`.
BACKEND_URL=http://localhost:8787

# Cloudflare Turnstile site key (public). Leave empty to use Cloudflare's always-pass test key,
# which pairs with the test secret in apps/api/.env.example.
VITE_TURNSTILE_SITE_KEY=
